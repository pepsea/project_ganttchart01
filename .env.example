# ---- Linux サーバー用の設定例 ----
# このファイルを .env にコピーして値を変更する:  cp .env.example .env

# ログインパスワード（必ず変更する）
APP_PASSWORD=change-me-to-a-strong-password

# 公開するポート（http://サーバー:PORT/）
PORT=5005

# データ（DB とバックアップ）の保存先（ホストのフォルダ）。
# git のフォルダの外に置くと、git pull・git clean・フォルダの入れ替えでも絶対に変更されない（推奨）
#   sudo mkdir -p /srv/gantt-pm/data && sudo chown 1000:1000 /srv/gantt-pm/data
# （./data でも動くが、git のフォルダの中になる。git 管理外なので pull では変わらないが、git clean -x で消える）
DATA_PATH=/srv/gantt-pm/data

# 新規インストール時にサンプルデータを入れない
SEED_SAMPLE_DATA=0

# データフォルダの所有者（id -u / id -g で確認。通常の最初のユーザーは 1000）
APP_UID=1000
APP_GID=1000

# https（リバースプロキシ経由）で公開する場合は 1
COOKIE_SECURE=0
