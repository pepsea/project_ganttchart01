# ---- Linux サーバー用の設定例 ----
# このファイルを .env にコピーして値を変更する:  cp .env.example .env

# ログインパスワード（必ず変更する）
APP_PASSWORD=change-me-to-a-strong-password

# 公開するポート（http://サーバー:PORT/）
PORT=5005

# データの保存先（ホストのフォルダ）。アプリを更新・入れ替えてもここは残る
DATA_PATH=./data

# 新規インストール時にサンプルデータを入れない
SEED_SAMPLE_DATA=0

# データフォルダの所有者（id -u / id -g で確認。通常の最初のユーザーは 1000）
APP_UID=1000
APP_GID=1000

# https（リバースプロキシ経由）で公開する場合は 1
COOKIE_SECURE=0
